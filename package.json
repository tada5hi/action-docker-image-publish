{
    "name": "action-docker-image-publish",
    "version": "3.4.0",
    "type": "module",
    "description": "Release (build, tag & push) docker images.",
    "main": "dist/index.mjs",
    "types": "dist/index.d.mts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs"
        }
    },
    "bin": {
        "action-docker-image-publish": "dist/cli.mjs"
    },
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=22.0.0"
    },
    "scripts": {
        "build": "tsdown",
        "commit": "npx git-cz",
        "lint": "eslint",
        "lint:fix": "npm run lint -- --fix",
        "test": "vitest --config test/vitest.config.ts --run",
        "test:coverage": "vitest --config test/vitest.config.ts --run --coverage",
        "prepare": "husky",
        "start": "node dist/cli.mjs"
    },
    "author": {
        "name": "Peter Placzek",
        "email": "contact@tada5hi.net",
        "url": "https://github.com/tada5hi"
    },
    "license": "MIT",
    "keywords": [
        "docker",
        "release",
        "publish",
        "tag",
        "build",
        "push",
        "versioning"
    ],
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/tada5hi/action-docker-image-publish.git"
    },
    "bugs": {
        "url": "https://github.com/tada5hi/action-docker-image-publish/issues"
    },
    "homepage": "https://github.com/tada5hi/action-docker-image-publish#readme",
    "devDependencies": {
        "@tada5hi/commitlint-config": "^1.3.1",
        "@tada5hi/eslint-config": "^2.3.1",
        "@tada5hi/tsconfig": "^0.7.2",
        "@types/md5": "^2.3.6",
        "@types/node": "^24.10.1",
        "@types/semver": "^7.7.0",
        "@vitest/coverage-v8": "^4.1.10",
        "eslint": "^10.8.0",
        "husky": "^9.1.7",
        "tsdown": "^0.22.14",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.65.0",
        "vitest": "^4.1.10"
    },
    "dependencies": {
        "citty": "^0.2.2",
        "consola": "^3.4.2",
        "md5": "^2.3.0",
        "semver": "^7.8.5"
    }
}
